# Application
APP_NAME="LeadForm SaaS"
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true
APP_KEY=your-secret-key-here-min-32-chars!!
APP_LOCALE=pt_BR

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leadform_saas
DB_USER=root
DB_PASS=

# Mail
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@leadform.io
MAIL_FROM_NAME="LeadForm"

# Storage
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,csv,zip

# AI Configuration
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_MAPS_API_KEY=

# Facebook
FACEBOOK_PIXEL_ID=

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# JWT
JWT_SECRET=your-jwt-secret-key-here-min-32!!
JWT_EXPIRY=86400
